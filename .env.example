# SMTP_PORT=587
# SMTP_USER=verified-sender@example.com
# SMTP_PASS=configure-in-hosting
# SMTP_FROM=verified-sender@example.com
# META_CAPI_ACCESS_TOKEN=configure-in-hosting
# META_GRAPH_API_VERSION=version-enabled-in-your-meta-app
